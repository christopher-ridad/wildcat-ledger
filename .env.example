VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Error monitoring — get DSN from sentry.io. Omit to disable Sentry locally.
VITE_SENTRY_DSN=

# Used for receipt/budget-document OCR (src/utilities/parseReceipt.ts,
# parseBudgetAllocation.ts). Without it, those scan features throw immediately.
VITE_GOOGLE_VISION_API_KEY=

# Admin scripts only (scripts/importAdmins.mjs) — never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=
